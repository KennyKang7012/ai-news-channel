# AI News Channel — Environment Variables
# Copy this to .env and fill in your keys
# Never commit .env to git!

# ── AI Models ──────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
GEMINI_API_KEY=AIza-your-key-here
OPENAI_API_KEY=sk-your-openai-key-here

# ── Publishing — Medium ────────────────────
MEDIUM_TOKEN=your-medium-integration-token
# Get from: https://medium.com/me/settings → Integration tokens

# ── Publishing — Twitter/X ────────────────
TWITTER_API_KEY=your-api-key
TWITTER_API_SECRET=your-api-secret
TWITTER_ACCESS_TOKEN=your-access-token
TWITTER_ACCESS_SECRET=your-access-secret
TWITTER_BEARER_TOKEN=your-bearer-token
# Get from: https://developer.twitter.com

# ── Publishing — LinkedIn ─────────────────
LINKEDIN_ACCESS_TOKEN=your-access-token
LINKEDIN_PERSON_ID=your-person-id
# Get from: https://www.linkedin.com/developers

# ── Publishing — Threads ──────────────────
THREADS_ACCESS_TOKEN=your-access-token
THREADS_USER_ID=your-user-id
# Get from: https://developers.facebook.com/docs/threads

# ── Newsletter — SendGrid ─────────────────
SENDGRID_API_KEY=SG.your-key-here
NEWSLETTER_FROM_EMAIL=newsletter@yourchannel.com
NEWSLETTER_LIST_ID=your-list-id
# Get from: https://app.sendgrid.com

# ── Channel Config ─────────────────────────
CHANNEL_NAME=AI News Daily
CHANNEL_URL=https://yourchannel.com
CHANNEL_TWITTER_HANDLE=@YourHandle
